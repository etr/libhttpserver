    }
  ],
  "quic_exclusions": {
    "handshakeloss": "Loss category uses the unchanged transferloss predicate; extreme-loss 50-connection multiconnect is outside this bounded matrix.",
    "rebind-addr": "Rebinding category uses rebind-port, including PATH_CHALLENGE/PATH_RESPONSE predicates.",
    "closure": "Pinned runner has no dedicated closure predicate; transfer needs an additional authenticated zero-error CONNECTION_CLOSE witness. Transfer success alone cannot satisfy closure.",
    "aioquic": "Pinned aioquic 1.3.0 passed five cases but timed out on repeated port rebinding; simulator captures show no client packet after translation. Required rebinding remains covered by picoquic, not waived."
  }
